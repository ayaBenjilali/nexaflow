{
  "name": "nexaflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-quality MERN SaaS CRM and project management platform with React, Node.js, Express, MongoDB, TypeScript and Capacitor.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev -w @nexaflow/server\" \"npm:dev -w @nexaflow/web\"",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "seed": "npm run seed -w @nexaflow/server",
    "cap:sync": "npm run build -w @nexaflow/web && npx cap sync"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.43.0"
  }
}
